@page "/login"
@using Cssao.Admin.Client.Services
@using Cssao.Shared.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider

<div class="login-container">
    <div class="login-card">
        <h2>管理员登录</h2>
        <p>请输入您的账号信息</p>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="alert alert-danger">
                @ErrorMessage
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>用户名</label>
                <InputText @bind-Value="loginModel.Username" class="form-control" />
            </div>

            <div class="form-group">
                <label>密码</label>
                <InputText @bind-Value="loginModel.Password" type="password" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary w-100" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                    <span> 登录中...</span>
                }
                else
                {
                    <span>登录</span>
                }
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginRequestDto loginModel = new();
    private string? ErrorMessage;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        // ✅ 使用 AuthenticationStateProvider 检查是否已登录
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/", forceLoad: false);
        }
        // ✅ 不再需要 TryRefreshAuthStateAsync()
        // 因为 CustomAuthStateProvider 已经在 GetAuthenticationStateAsync() 中自动读取 localStorage
    }


    private async Task HandleLogin()
    {
        if (isLoading) return;

        isLoading = true;
        ErrorMessage = null;

        try
        {
            // ✅ AuthService.LoginAsync 不再返回 bool，而是直接调用 NotifyUserLoggedIn
            // 但你可以保留返回 bool 用于 UI 判断
            var success = await AuthService.LoginAsync(loginModel.Username, loginModel.Password);
            if (success)
            {
                // ✅ 登录成功后，AuthenticationState 已由 NotifyUserLoggedIn 触发更新
                Navigation.NavigateTo("/", forceLoad: false);
            }
            else
            {
                ErrorMessage = "用户名或密码错误";
            }
        }
        catch (HttpRequestException)
        {
            ErrorMessage = "无法连接到服务器，请检查网络";
        }
        catch (Exception ex)
        {
            ErrorMessage = "登录失败，请重试";
            Console.WriteLine($"Login Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}