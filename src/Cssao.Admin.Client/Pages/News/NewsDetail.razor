@page "/news/detail/{Id:int}"
@using Cssao.Admin.Client.Services
@using Cssao.Shared.Models.Admin
@inject NewsService NewsService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h3>新闻详情</h3>

<div class="card">
    <div class="card-header bg-light">
        <h5 class="mb-0">@_news?.Title</h5>
    </div>

    <div class="card-body">
        @if (_isLoading)
        {
            <div class="text-center text-muted">
                <span class="spinner-border spinner-border-sm"></span> 加载中...
            </div>
        }
        else if (_news == null)
        {
            <div class="alert alert-warning">
                未找到该新闻，可能已被删除。
            </div>
        }
        else
        {
            <dl class="row">
                <dt class="col-sm-2">标题</dt>
                <dd class="col-sm-10">@_news.Title</dd>

                <dt class="col-sm-2">分类</dt>
                <dd class="col-sm-10">
                    <span class="badge bg-primary">@(_news.Category?.Name ?? "未分类")</span>
                </dd>

                <dt class="col-sm-2">内容</dt>
                <dd class="col-sm-10">
                    <div class="border p-3 bg-light" style="white-space: pre-wrap; font-family: var(--bs-font-sans-serif);">
                        @_news.Content
                    </div>
                </dd>

                <dt class="col-sm-2">发布时间</dt>
                <dd class="col-sm-10">@_news.PublishDate.ToString("yyyy-MM-dd HH:mm:ss")</dd>

                <dt class="col-sm-2">更新时间</dt>
                <dd class="col-sm-10">
                    @_news.UpdatedAt?.ToString("yyyy-MM-dd HH:mm:ss")
                    @if (_news.UpdatedAt == null)
                    {
                        <span class="text-muted">(未更新)</span>
                    }
                </dd>
            </dl>
        }
    </div>

    <div class="card-footer d-flex justify-content-between">
        <button class="btn btn-outline-secondary" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i> 返回列表
        </button>

        @if (_news != null)
        {
            <button class="btn btn-primary" @onclick="EditNews">
                <i class="bi bi-pencil"></i> 编辑
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private NewsDto? _news;
    private bool _isLoading = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadNews();
    }

    private async Task LoadNews()
    {
        _isLoading = true;
        _news = null;
        StateHasChanged(); // 刷新 UI 显示加载状态

        try
        {
            _news = await NewsService.GetNewsByIdAsync(Id);
        }
        catch (HttpRequestException httpEx)
        {
            Console.WriteLine($"请求错误: {httpEx.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "无法连接到服务器，请稍后重试。");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"未知错误: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "加载新闻失败，请稍后重试。");
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/news");
    }

    private void EditNews()
    {
        Navigation.NavigateTo($"/news/edit/{Id}");
    }
}