@page "/news"
@using Cssao.Admin.Client.Services
@using Cssao.Shared.Models.Admin
@inject NewsService NewsService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<h3>新闻管理</h3>

@* <div class="mb-3"> *@
@*     <button class="btn btn-primary" @onclick="() => Navigation.NavigateTo('/news/edit')"> *@
@*         + 新增新闻 *@
@*     </button> *@
@* </div> *@
<div class="mb-3">
    <button class="btn btn-primary" @onclick="NavigateToEdit">
        + 新增新闻
    </button>
    <button class="btn btn-outline-secondary" @onclick="Refresh">
        <i class="fas fa-sync"></i> 刷新
    </button>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>标题</th>
            <th>分类</th>
            <th>发布时间</th>
            <th>修改时间</th>
            <th>操作</th>
        </tr>
    </thead>
    <tbody>
        @if (newsList == null)
        {
            <tr><td colspan="4" class="text-center">加载中...</td></tr>
        }
        else if (!newsList.Items.Any())
        {
            <tr><td colspan="4" class="text-center">暂无新闻</td></tr>
        }
        else
        {
            foreach (var item in newsList.Items)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Category?.Name</td>
                    <td>@item.PublishDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.UpdatedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @* 编辑按钮 *@
                        <button class="btn btn-sm btn-outline-primary me-2"
                                @onclick="() => EditNews(item.Id)">
                            编辑
                        </button>

                        @* 删除按钮 *@
                        <button class="btn btn-sm btn-outline-danger"
                                @onclick="() => DeleteNews(item.Id, item.Title)">
                            删除
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private PagedResultDto<NewsDto> newsList = null!;

    protected override async Task OnInitializedAsync()
    {
        await LoadNews();
    }

    private async Task LoadNews()
    {
        try
        {
            newsList = await NewsService.GetNewsListAsync(pageIndex: 1, pageSize: 20);
        }
        catch (Exception ex)
        {
            // 可弹出错误提示
            Console.WriteLine(ex.Message);
        }
    }
    private async Task Refresh()
    {
        await LoadNews();
    }
    private void EditNews(int id)
    {
        Navigation.NavigateTo($"/news/edit/{id}");
    }

    private async Task DeleteNews(int id, string title)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"确定要删除新闻【{title}】吗？");
        if (confirm)
        {
            bool success = await NewsService.DeleteNewsAsync(id);
            if (success)
            {
                await LoadNews(); // 刷新列表
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "删除失败");
            }
        }
    }

    private void NavigateToEdit()
    {
        Navigation.NavigateTo("/news/edit");
    }
}